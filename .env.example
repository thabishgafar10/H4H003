# Application Database Configuration
APP_DATABASE_URL=sqlite:///./backend/data/temporal_knowledge.db
APP_DB_PATH=backend/data/temporal_knowledge.db

# LLM Extractor & Historical QA Configuration (Optional)
# If left blank, the system automatically runs deterministic grounded synthesis with zero hallucinations
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional Default External Integrations (for automated ingestion syncs)
# Jira Cloud
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=dev@company.com
JIRA_API_TOKEN=

# GitHub Public API Token (Optional: elevates rate limit from 60 req/hr to 5,000 req/hr)
GITHUB_TOKEN=

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
LOG_LEVEL=INFO
